<Window x:Class="DNSChanger.EditDnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit DNS" Height="420" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Border CornerRadius="14"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource StrokeBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="11"
                                   Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit DNS" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="CloseButton_Click"
                            HorizontalAlignment="Right" ToolTip="Close"/>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="22,18,22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="TITLE" Style="{StaticResource CaptionText}" Margin="1,0,0,8"/>
                        <TextBox Name="TitleTextBox" Height="40"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Text="PRIMARY DNS" Style="{StaticResource CaptionText}" Margin="1,0,0,8"/>
                        <TextBox Name="PrimaryDnsTextBox" Height="40"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="SECONDARY DNS (OPTIONAL)" Style="{StaticResource CaptionText}" Margin="1,0,0,8"/>
                        <TextBox Name="SecondaryDnsTextBox" Height="40"/>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Height="42" Content="Cancel" Click="Cancel_Click"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="42" Content="Save Changes" Click="Save_Click" Margin="10,0,0,0"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
